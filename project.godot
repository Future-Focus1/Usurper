; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Usurper"
config/description="Four lives. One crown. A political chronicle in the kingdom of Nezrel."
config/version="1.0.0"
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SaveManager="*res://scripts/managers/save_manager.gd"
MetaProgress="*res://scripts/managers/meta_progress.gd"
AudioManager="*res://scripts/managers/audio_manager.gd"
GameManager="*res://scripts/managers/game_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/handheld/orientation=1
window/size/min_width=1024
window/size/min_height=576

[rendering]

renderer/rendering_method="gl_compatibility"
